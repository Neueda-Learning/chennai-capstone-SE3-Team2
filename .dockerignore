# The build context is the repository root now, so keep out everything
# the image build has no use for. Without this, every target/ directory
# and the whole .git history are uploaded to the daemon on each build.
# Secrets stay out of every image too.
**/target/
.git/
.idea/
*.iml
.env
.env.*
!.env.example
.context/
sprint-04-analytics-etl/
**/*.png
**/node_modules
**/dist
**/.angular
**/__pycache__
**/.venv
terminal_ui_ref
Databases/DuckDB
