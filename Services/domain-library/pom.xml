<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>com.yellow</groupId>
    <artifactId>sprint5-domain</artifactId>
    <version>1.0-SNAPSHOT</version>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <junit.version>5.11.4</junit.version>
    </properties>

    <dependencies>

        <!-- The ONLY allowed non-test dependency -->
        <dependency>
            <groupId>jakarta.validation</groupId>
            <artifactId>jakarta.validation-api</artifactId>
            <version>3.1.1</version>
        </dependency>

        <!-- JUnit is test-only -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- Test dependencies -->
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <version>5.11.0</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.hamcrest</groupId>
            <artifactId>hamcrest</artifactId>
            <version>2.2</version>
            <scope>test</scope>
        </dependency>

        <!-- Validator implementation scoped to run tests -->
        <dependency>
            <groupId>org.hibernate.validator</groupId>
            <artifactId>hibernate-validator</artifactId>
            <version>8.0.1.Final</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.glassfish.expressly</groupId>
            <artifactId>expressly</artifactId>
            <version>5.0.0</version>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>21</release>
                    <!--
                      Keep parameter names in the class files.

                      PlaceOrderRequest has one constructor and no no-arg
                      constructor, so Jackson can only bind a JSON body to it
                      by matching names, and it can only see those names if
                      they survive compilation.

                      This was invisible while the domain was a folder of
                      source inside the Trade REST API, because Spring Boot's
                      parent adds the flag for you. Compiled here as its own
                      jar, the flag has to be asked for, and without it every
                      POST /api/v1/orders answers 500.

                      A no-arg constructor would also work, and would put a
                      framework's requirement inside the domain to do it.
                      This is a build flag instead.
                    -->
                    <parameters>true</parameters>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
            </plugin>

            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.12</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.5.0</version>

                <executions>
                    <execution>
                        <id>ban-forbidden-dependencies</id>

                        <goals>
                            <goal>enforce</goal>
                        </goals>

                        <configuration>
                            <rules>

                                <bannedDependencies>
                                    <searchTransitive>true</searchTransitive>

                                    <excludes>

                                        <!-- Spring -->
                                        <exclude>org.springframework:*</exclude>
                                        <exclude>org.springframework.boot:*</exclude>

                                        <!-- Servlet APIs -->
                                        <exclude>jakarta.servlet:*</exclude>
                                        <exclude>javax.servlet:*</exclude>

                                        <!-- MyBatis -->
                                        <exclude>org.mybatis:*</exclude>

                                        <!-- JDBC drivers -->
                                        <exclude>com.mysql:*</exclude>
                                        <exclude>mysql:*</exclude>
                                        <exclude>org.postgresql:*</exclude>
                                        <exclude>com.oracle.database.jdbc:*</exclude>
                                        <exclude>com.microsoft.sqlserver:*</exclude>
                                        <exclude>org.xerial:sqlite-jdbc</exclude>
                                        <exclude>com.h2database:h2</exclude>

                                        <!-- Connection pools -->
                                        <exclude>com.zaxxer:HikariCP</exclude>
                                        <exclude>org.apache.commons:commons-dbcp2</exclude>
                                        <exclude>org.apache.tomcat:tomcat-jdbc</exclude>

                                    </excludes>

                                </bannedDependencies>

                            </rules>

                            <fail>true</fail>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

        </plugins>
    </build>

</project>