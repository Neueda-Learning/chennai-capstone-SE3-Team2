BASE_PACKAGE=com.yellow.trade
CONTROLLER_PACKAGE=com.yellow.trade.controllers
MAPPER_PACKAGE=com.yellow.trade.mappers
# Layering check targets.
SERVICE_PACKAGE=com.yellow.trade.services
DOMAIN_PACKAGES=com.yellow.dto,com.yellow.entities,com.yellow.enums,com.yellow.exceptions,com.yellow.repositories,com.yellow.services

# Story 212 allowlist: statements that legitimately interpolate a column name
# or sort direction rather than binding it. There are none. Every value that
# arrives from outside is a bind parameter, and no statement takes a column
# name or a sort direction from a caller at all -- the one ordering the API
# exposes is fixed (order history is newest first) and written into the
# statement, not chosen by the request.
MAPPER_INTERPOLATION_ALLOWLIST=
