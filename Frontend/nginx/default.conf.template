# The frontend container's nginx: the built UI, plus the API paths forwarded
# to the services on the Docker network. ${ORDER_SERVICE_URL} and
# ${AUTH_SERVICE_URL} are filled from the environment when the container starts.

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;

    # Docker's own DNS. The service names are looked up per request, so a
    # service that restarts (and comes back on another address) is still found.
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $order_service ${ORDER_SERVICE_URL};
    set $auth_service ${AUTH_SERVICE_URL};

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $host;

    # The Trade REST API (order-service): /api/v1/... as it is.
    location /api/ {
        proxy_pass $order_service;
    }

    # The auth-service: login, refresh, register, /auth/me ...
    location /auth/ {
        proxy_pass $auth_service;
    }

    # ... and the activation page the email links to (/activate, /activate/done).
    location /activate {
        proxy_pass $auth_service;
    }

    # The page itself is never cached: it names the current hashed bundles.
    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    # Every other path is a route of the single-page app.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
