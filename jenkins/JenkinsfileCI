// Yellow Trade CI: build the four images and push them to ECR with one new tag (k8s/README.md step 5).
// Deploys nothing: run JenkinsfileCD with the tag this prints. See jenkins/jenkins-steps.md.
pipeline {
  agent any

  options {
    disableConcurrentBuilds()
    skipDefaultCheckout(true)
    timeout(time: 45, unit: 'MINUTES')
    buildDiscarder(logRotator(numToKeepStr: '20'))
  }

  triggers {
    // Checks the branch every 5 minutes and builds only when it changed. With the GitHub
    // plugin and a repository webhook, githubPush() can replace this.
    pollSCM('H/5 * * * *')
  }

  parameters {
    string(name: 'AWS_REGION', defaultValue: 'ap-south-1', description: 'AWS region of ECR and EKS')
    booleanParam(name: 'RUN_TESTS', defaultValue: true, description: 'mvn test (order, executor, domain) before building')
  }

  environment {
    AUTH_REPO     = 'etp-auth-service'
    ORDER_REPO    = 'etp-order-service'
    EXECUTOR_REPO = 'etp-executor-service'
    FRONTEND_REPO = 'etp-frontend'
  }

  stages {
    stage('Checkout SCM') {
      steps {
        checkout scm
        script {
          env.AWS_REGION  = params.AWS_REGION?.trim() ?: 'ap-south-1'
          env.RELEASE_TAG = "1.${env.BUILD_NUMBER}"
          env.GIT_SHORT   = sh(script: 'git rev-parse --short=12 HEAD', returnStdout: true).trim()
        }
        echo "commit ${env.GIT_SHORT} -> tag ${env.RELEASE_TAG}"
      }
    }

    stage('Validate build agent') {
      steps {
        sh '''#!/usr/bin/env bash
          set -euo pipefail
          command -v aws >/dev/null
          command -v docker >/dev/null
          docker info >/dev/null          # fails when the jenkins user is not in the docker group
          test -f Services/auth-service/Dockerfile
          test -f Services/order-service/Dockerfile
          test -f Services/executor-service/Dockerfile
          test -f Frontend/Dockerfile
        '''
      }
    }

    stage('Test') {
      when { expression { params.RUN_TESTS } }
      steps {
        sh 'mvn -B test'
      }
    }

    stage('Build and push ECR') {
      steps {
        script {
          env.AWS_ACCOUNT_ID = sh(script: 'aws sts get-caller-identity --query Account --output text', returnStdout: true).trim()
          env.REGISTRY = "${env.AWS_ACCOUNT_ID}.dkr.ecr.${env.AWS_REGION}.amazonaws.com"
        }
        sh '''#!/usr/bin/env bash
          set -euo pipefail
          aws ecr get-login-password --region "$AWS_REGION" | docker login --username AWS --password-stdin "$REGISTRY"

          for repo in "$AUTH_REPO" "$ORDER_REPO" "$EXECUTOR_REPO" "$FRONTEND_REPO"; do
            aws ecr describe-repositories --region "$AWS_REGION" --repository-names "$repo" >/dev/null 2>&1 || \
            aws ecr create-repository --region "$AWS_REGION" --repository-name "$repo" \
              --image-scanning-configuration scanOnPush=true \
              --encryption-configuration encryptionType=AES256 >/dev/null
          done

          # The Java images build from the repository root (they need the domain module).
          # The frontend needs no build-time URLs: it calls its own origin, and its nginx
          # forwards the API paths inside the cluster.
          docker build -t "$REGISTRY/$AUTH_REPO:$RELEASE_TAG"     -f Services/auth-service/Dockerfile .
          docker build -t "$REGISTRY/$ORDER_REPO:$RELEASE_TAG"    -f Services/order-service/Dockerfile .
          docker build -t "$REGISTRY/$EXECUTOR_REPO:$RELEASE_TAG" -f Services/executor-service/Dockerfile .
          docker build -t "$REGISTRY/$FRONTEND_REPO:$RELEASE_TAG" ./Frontend

          for repo in "$AUTH_REPO" "$ORDER_REPO" "$EXECUTOR_REPO" "$FRONTEND_REPO"; do
            docker push "$REGISTRY/$repo:$RELEASE_TAG"
          done
          echo "CI image tag: $RELEASE_TAG (commit $GIT_SHORT)"
          echo "IMAGE_TAG=$RELEASE_TAG"
        '''
      }
    }
  }

  post {
    success {
      script { currentBuild.description = "IMAGE_TAG=${env.RELEASE_TAG}" }
    }
    always {
      sh 'docker logout "${REGISTRY:-}" >/dev/null 2>&1 || true'
      // The images are in ECR now; keep the Jenkins box's disk from filling up.
      sh 'docker image prune -f >/dev/null 2>&1 || true'
    }
  }
}
