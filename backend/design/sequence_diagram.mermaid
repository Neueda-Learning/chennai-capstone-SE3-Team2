---
title: Place Order
---
sequenceDiagram
    autonumber
    actor Caller as Caller
    participant Svc as OrderService
    participant AccRepo as AccountRepository
    participant Acc as Account
    participant InsRepo as InstrumentRepository
    participant Ins as Instrument
    participant PosRepo as PositionRepository
    participant Pos as Position
    participant OrdRepo as OrderRepository

    Note over Caller,OrdRepo: Rules run in a fixed order and the FIRST FAILURE WINS.
    Caller->>Svc: placeOrder(PlaceOrderRequest)
    Note right of Caller: The API

    %% ---------------------------------------------------------------
    rect rgb(245, 235, 235)
    Note over Svc,AccRepo: RULE 1 — the account exists
    Svc->>AccRepo: findById(accountId)
    AccRepo-->>Svc: Optional<Account>
    alt account not found
        Svc-->>Caller: throw AccountNotFoundException (ACC-404)
        Note right of Svc: EXIT. Nothing read, nothing written.
    end
    end

    %% ---------------------------------------------------------------
    rect rgb(245, 235, 235)
    Note over Svc,Acc: RULE 2 — the account is active
    Svc->>Acc: isActive()
    Acc-->>Svc: false (SUSPENDED or CLOSED)
    alt not ACTIVE
        Svc-->>Caller: throw AccountNotActiveException (ACC-403)
        Note right of Svc: EXIT before any cash is looked at.
    end
    end

    %% ---------------------------------------------------------------
    rect rgb(245, 235, 235)
    Note over Svc,Ins: RULE 3 — the instrument exists and is tradable
    Svc->>InsRepo: findBySymbol(symbol)
    InsRepo-->>Svc: Optional<Instrument>
    alt symbol unknown
        Svc-->>Caller: throw InstrumentNotFoundException (INS-404, reason=UNKNOWN)
        Note right of Svc: EXIT.
    end
    Svc->>Ins: isTradable()
    Ins-->>Svc: false
    alt delisted or suspended
        Svc-->>Caller: throw InstrumentNotFoundException (INS-404, reason=NOT_TRADABLE)
        Note right of Svc: EXIT.
    end
    end

    %% ---------------------------------------------------------------
    rect rgb(240, 240, 225)
    Note over Svc: RULE 4 — quantity is in range
    alt quantity null, zero, negative or above the cap
        Svc-->>Caller: throw InvalidOrderException (ORD-422, field=quantity)
        Note right of Svc: EXIT. 
    end
    end

    %% ---------------------------------------------------------------
    rect rgb(240, 240, 225)
    Note over Svc: RULE 5 — price is in range
    alt price null, zero, negative or above the cap
        Svc-->>Caller: throw InvalidOrderException (ORD-422, field=price)
        Note right of Svc: EXIT.
    end
    end

    %% ---------------------------------------------------------------
    rect rgb(245, 235, 235)
    Note over Svc,Acc: RULE 6 — affordability, on a BUY only
    alt side == BUY
        Svc->>Acc: canAfford(quantity * price)
        Acc-->>Svc: false
        alt cannot afford
            Svc-->>Caller: throw InsufficientFundsException (ORD-400)
            Note right of Svc: EXIT. 
        end
    end
    end

    %% ---------------------------------------------------------------
    rect rgb(245, 235, 235)
    Note over Svc,Pos: RULE 7 — held quantity, on a SELL only
    alt side == SELL
        Svc->>PosRepo: find(accountId, instrumentId)
        PosRepo-->>Svc: Optional<Position>
        Svc->>Pos: canSell(quantity)
        Pos-->>Svc: false
        alt no position, or not enough held
            Svc-->>Caller: throw InsufficientHoldingsException (POS-400)
            Note right of Svc: EXIT. 
        end
    end
    end

    %% ---------------------------------------------------------------
    rect rgb(245, 235, 235)
    Note over Svc,OrdRepo: RULE 8 — the idempotency key is unused
    Svc->>OrdRepo: existsByAccountAndKey(accountId, idempotencyKey)
    OrdRepo-->>Svc: true
    alt key already used by this account
        Svc-->>Caller: throw DuplicateOrderException (ORD-409)
        Note right of Svc: EXIT. 
    end
    end

    %% ---------------------------------------------------------------
    rect rgb(230, 242, 232)
    Note over Svc,OrdRepo: The accepted path
    create participant Ord as Order
    Svc->>Ord: new Order(status = NEW)
    Note right of Ord: Created only here. On all nine refusal<br/>paths above, no Order ever exists.
    Svc->>OrdRepo: save(order)
    OrdRepo-->>Svc: Order (orderId assigned)
    Svc-->>Caller: Order (status = NEW)
    end

