# The frontend's nginx on Kubernetes. The same as the image's own
# Frontend/nginx/default.conf.template except for how the upstreams are found:
# that one asks Docker's DNS (127.0.0.11), which does not exist in a pod. Here
# each service name is resolved once, at start, by the cluster DNS -- a
# Service's ClusterIP stays the same for its whole life, so there is nothing to
# look up again. ${ORDER_SERVICE_URL} and ${AUTH_SERVICE_URL} come from
# frontend.yaml. Keep the locations in step with the image's template.

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $host;

    # The Trade REST API (order-service): /api/v1/... as it is.
    location /api/ {
        proxy_pass ${ORDER_SERVICE_URL};
    }

    # order-service's one public route outside /api: applying for an account
    # (POST /onboarding/applications, no token).
    location /onboarding/ {
        proxy_pass ${ORDER_SERVICE_URL};
    }

    # The auth-service: login, refresh, register, /auth/me ...
    location /auth/ {
        proxy_pass ${AUTH_SERVICE_URL};
    }

    # ... and the activation page the email links to (/activate, /activate/done).
    location /activate {
        proxy_pass ${AUTH_SERVICE_URL};
    }

    # The page itself is never cached: it names the current hashed bundles.
    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    # Every other path is a route of the single-page app.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
