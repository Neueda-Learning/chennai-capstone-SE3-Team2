# TEMPLATE. Copy it to secrets.env (same folder) and fill in every value:
#   cp k8s/base/secrets.env.example k8s/base/secrets.env
# secrets.env is gitignored: never commit it. Kustomize turns it into the
# Secret yellow-trade-secrets; each service is given only the keys it uses.
# The same values as the repository's .env. Letters and digits; no quotes.

# order-service and executor-service: the trading_app password given to setup.sql.
DB_PASSWORD=
# auth-service: the auth_app password given to setup.sql.
AUTH_DB_PASSWORD=

# auth-service and order-service: the same value. openssl rand -hex 32
JWT_SECRET=
# auth-service and order-service: the same value. openssl rand -hex 32
ACTIVATION_INTERNAL_SECRET=

# order-service: the activation email. Gmail: an app password.
SMTP_USERNAME=
SMTP_PASSWORD=
ACTIVATION_MAIL_FROM=

# auth-service: the login throttle's Redis. redis://default:<password>@<host>:<port>
REDIS_URL=

# executor-service (required) and order-service: stock prices.
FAUXNANCE_API_KEY=
# Mutual fund prices. May stay empty: fund orders are then rejected, all else trades.
MF_NAV_API_KEY=

# ONLY with the optional in-cluster Postgres (optional/postgres). Leave empty for RDS.
# The superuser that builds the database, and the read-only analytics role's password.
POSTGRES_SUPERUSER_PASSWORD=
ANALYTICS_DB_PASSWORD=
