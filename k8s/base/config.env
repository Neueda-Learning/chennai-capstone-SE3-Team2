# NON-SECRET settings for auth-service, order-service and executor-service
# (ConfigMap yellow-trade-config, given to each as environment variables).
# The same keys as the repository's .env.example. Secrets go in secrets.env.
# Format: KEY=value, one per line, no quotes, comments on their own lines only.
# The ports are not here: each Deployment sets its own (3000, 8081, 8082).

# --- Database: ONE database, trading_system_db, schemas public and auth.
# Amazon RDS: its endpoint, and DB_SSLMODE=require. Built beforehand with
# Databases/PostgreSQL/local/setup.sql (README step 4).
# With the optional in-cluster Postgres, leave these: the component switches
# DB_HOST to postgres and DB_SSLMODE to prefer by itself.
DB_HOST=database-1.cvaw4g8k84t2.ap-south-1.rds.amazonaws.com
DB_PORT=5432
DB_NAME=trading_system_db
DB_SSLMODE=require
# order-service and executor-service: read/write on public.
DB_USER=trading_app
# auth-service: its own role, and its own schema only.
AUTH_DB_USER=auth_app
AUTH_DB_SCHEMA=auth

# --- Kafka: the broker in this namespace (kafka.yaml), on its internal listener.
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_BROKERS=kafka:29092

# --- Tokens: auth signs, order-service checks, with JWT_SECRET (secrets.env).
JWT_ISSUER=auth-service

# --- Account activation: order-service asks auth for the token over the
# cluster network, then mails the link.
AUTH_INTERNAL_URL=http://auth-service:3000
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# --- Prices
FAUXNANCE_BASE_URL=https://y4t9nq2bqf.execute-api.eu-west-2.amazonaws.com/v1
MF_NAV_BASE_URL=https://mf-fauxnance-api.onrender.com
POLL_INTERVAL_SECONDS=60
MARKET_DATA_DAILY_BUDGET=400

# --- Timings and switches (the defaults; KYC_DELAY can be shortened for a demo)
KYC_DELAY=30s
KYC_JOB_INTERVAL_MS=10000
KYC_MAX_ATTEMPTS=5
KYC_BATCH_SIZE=50
PAYMENT_DELAY=3s
PAYMENT_JOB_INTERVAL_MS=2000
OUTBOX_POLL_MS=2000
KYC_JOB_ENABLED=true
PAYMENT_JOB_ENABLED=true
OUTBOX_RELAY_ENABLED=true
ACTIVATION_CONSUMER_ENABLED=true
POLLER_ENABLED=true

# --- Behind the frontend's nginx: auth believes X-Forwarded-For from private
# addresses only (the pod network), so the login throttle counts per browser.
TRUST_PROXY=uniquelocal
LOG_LEVEL=INFO
