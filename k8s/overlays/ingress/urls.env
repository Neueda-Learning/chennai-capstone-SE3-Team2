# The address the browser opens: http:// (https:// with a certificate) + the ALB's DNS
# name or your domain. No port, no trailing slash. The ALB's name exists only after the
# first apply:
#   kubectl -n yellow-trade get ingress yellow-trade      (ADDRESS column)
# Write it into all three lines, then apply again (README step 10).
CORS_ALLOWED_ORIGINS=http://alb-address-pending.invalid
ACTIVATION_LINK_BASE_URL=http://alb-address-pending.invalid/activate
ACTIVATION_HOME_URL=http://alb-address-pending.invalid/
