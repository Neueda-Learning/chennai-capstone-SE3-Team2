# ONE settings file for the whole platform. Copy it to .env and fill in the
# values marked REQUIRED. .env is gitignored: never commit it.
#
#   Linux / macOS:   cp .env.example .env
#   Windows:         copy .env.example .env
#
# Who reads it:
#   - docker compose, for every container  (docker compose up -d --build)
#   - trade-api and the executor, when started from IntelliJ or mvn (not in a container)
#   - auth, when started with npm run start:dev                     (not in a container)
# In a container, compose sets the service addresses itself (postgres, kafka,
# auth), so the localhost values below only apply outside one.
#
# Format: KEY=value, one per line. Comments on their own lines only -- never
# after a value. No quotes. Avoid $ in values: use letters and digits, e.g.
#   openssl rand -hex 32
#
# Hosts and ports live in Config/application.yml (UI 4200, auth-service 3000,
# order-service 8081, executor-service 8082, PostgreSQL 5432, Kafka 9092).
# A variable here of the same meaning wins over that file.


# ======================================================================
# docker compose -- what runs
# ======================================================================

# localdb   the bundled PostgreSQL container (leave it out to use RDS)
# platform  Kafka (+ topics), auth-service, order-service, executor-service
# frontend  the UI served by nginx on FRONTEND_PUBLISHED_PORT, with the APIs
#           behind it on the same origin (leave it out to use `npm start`)
# etl       the analytics ETL, run once:  docker compose run --rm etl
COMPOSE_PROFILES=localdb,platform
# Host port of the frontend container (profile frontend).
FRONTEND_PUBLISHED_PORT=4200


# ======================================================================
# Service ports -- the same values as Config/application.yml
# ======================================================================

# order-service (the Trade REST API).
TRADE_API_PORT=8081
# executor-service (the Trade Executor).
EXECUTOR_PORT=8082
# auth-service.
PORT=3000
# auth-service: development or production; tests set test themselves.
NODE_ENV=development


# ======================================================================
# PostgreSQL -- ONE database, trading_system_db, with two schemas:
#   public  the trading platform   auth  the auth service's logins
# ======================================================================

# Where the services find it when they run OUTSIDE Docker (IntelliJ, npm).
DB_HOST=localhost
DB_PORT=5432
# Where the containers find it. Empty: the bundled postgres container
# (profile localdb). For RDS: the RDS endpoint, and leave localdb out of
# COMPOSE_PROFILES.
CONTAINER_DB_HOST=
CONTAINER_DB_PORT=5432
# SSL to the database: prefer (local) or require (RDS, PostgreSQL 15+).
DB_SSLMODE=prefer

# The superuser: only builds the database (compose's init, or
# Databases/PostgreSQL/local/setup.sql on Windows or RDS). No service ever
# connects as it.
POSTGRES_SUPERUSER=postgres
# REQUIRED by compose. On Windows: the password chosen when installing PostgreSQL.
POSTGRES_SUPERUSER_PASSWORD=change-me

# order-service and executor-service: read/write on trading_system_db. Not the superuser.
DB_NAME=trading_system_db
DB_USER=trading_app
# REQUIRED.
DB_PASSWORD=change-me

# The analytics extract: read-only on trading_system_db.
ANALYTICS_DB_USER=analytics_ro
# REQUIRED by compose.
ANALYTICS_DB_PASSWORD=change-me

# auth: its own role and schema in the same database, and only that schema.
AUTH_DB_USER=auth_app
AUTH_DB_SCHEMA=auth
# REQUIRED. auth builds its connection from these, DB_HOST/DB_PORT and DB_NAME.
AUTH_DB_PASSWORD=change-me
# Optional: a full connection URL for auth instead of the parts above.
# Example:  postgresql://auth_app:change-me@localhost:5432/trading_system_db
AUTH_DATABASE_URL=

# Connections each Java service keeps open to PostgreSQL.
DB_POOL_MAX=10

# Compose only: the host port the Postgres container is published on.
DB_PUBLISHED_PORT=5432


# ======================================================================
# Kafka -- in a container. On Windows it is on the EC2 instance, reached
# through the SSH forward (ssh -L 9092:localhost:9092 ...).
# ======================================================================

# trade-api and the executor.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# auth. REQUIRED.
KAFKA_BROKERS=localhost:9092


# ======================================================================
# Tokens -- auth signs them, trade-api checks them, with the same secret
# ======================================================================

# REQUIRED. At least 32 bytes:  openssl rand -hex 32
JWT_SECRET=replace-with-openssl-rand-hex-32-output
JWT_ISSUER=auth-service


# ======================================================================
# Account activation -- the email with the one-time link
# ======================================================================

# REQUIRED. Shared by auth and trade-api; guards auth's internal route.
# At least 32 bytes:  openssl rand -hex 32
ACTIVATION_INTERNAL_SECRET=replace-with-openssl-rand-hex-32-output

# How trade-api reaches auth to mint a link.
AUTH_INTERNAL_URL=http://localhost:3000
# The link in the email: auth's /activate page.
ACTIVATION_LINK_BASE_URL=http://localhost:3000/activate
# Where the customer lands after choosing a password: the UI.
ACTIVATION_HOME_URL=http://localhost:4200/

# Outgoing mail. Gmail: an app password, not the account password
# (Google Account > Security > 2-Step Verification > App passwords).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# REQUIRED.
SMTP_USERNAME=your-team-address@gmail.com
# REQUIRED.
SMTP_PASSWORD=your-16-character-app-password
# REQUIRED. Usually the same as SMTP_USERNAME.
ACTIVATION_MAIL_FROM=your-team-address@gmail.com


# ======================================================================
# Login throttle -- five failed logins, then a minute's wait
# ======================================================================

# REQUIRED by compose. The hosted Redis every auth instance counts in.
# Outside compose it may be left out: the count is then kept in memory.
REDIS_URL=redis://default:password@host:port


# ======================================================================
# Prices -- the executor prices every order before it fills, and
# trade-api shows prices and charts on the screens
# ======================================================================

# REQUIRED. Stocks and ETFs. Read by the executor and by trade-api.
FAUXNANCE_API_KEY=replace-with-your-cohort-key
FAUXNANCE_BASE_URL=https://y4t9nq2bqf.execute-api.eu-west-2.amazonaws.com/v1
# Seconds between market-data polls. 60 costs 1440 of the 2000 daily
# Fauxnance requests. The floor is enforced in code.
POLL_INTERVAL_SECONDS=60

# Mutual funds, at the latest NAV. Optional: without a key, fund orders are
# rejected with no price and everything else still trades.
MF_NAV_API_KEY=
MF_NAV_BASE_URL=https://mf-fauxnance-api.onrender.com
# Fauxnance requests trade-api may spend a day on screen prices and charts,
# out of the key's 2000. Prices are kept a minute and charts six hours, so
# this goes a long way; past it, the last prices known are shown as stale.
MARKET_DATA_DAILY_BUDGET=400


# ======================================================================
# Timings -- optional; these are the defaults
# ======================================================================

# How long KYC waits before checking an application (shorten for a demo),
# how often it looks, and how many failed checks before a customer is set aside.
KYC_DELAY=30s
KYC_JOB_INTERVAL_MS=10000
KYC_MAX_ATTEMPTS=5
# How long the payment gateway takes to decide a deposit or withdrawal.
PAYMENT_DELAY=3s
# How often trade-api and auth publish what their outboxes hold.
OUTBOX_POLL_MS=2000
# Applications KYC decides per run.
KYC_BATCH_SIZE=50
# How often the payment job looks for transfers to decide.
PAYMENT_JOB_INTERVAL_MS=2000

# Switches for the background work, all on by default. Turn one off only to
# isolate a problem: off, that work simply does not happen.
KYC_JOB_ENABLED=true
PAYMENT_JOB_ENABLED=true
OUTBOX_RELAY_ENABLED=true
ACTIVATION_CONSUMER_ENABLED=true
# The executor's market-data poller.
POLLER_ENABLED=true


# ======================================================================
# Analytics ETL (ETL Layer/) -- reads trading_system_db as analytics_ro
# ======================================================================

# The DuckDB star schema it writes, and where rows it cannot load are kept.
DUCKDB_PATH=Databases/DuckDB/analytics/analytics.duckdb
DEAD_LETTER_DIR=ETL Layer/data/dead_letters


# ======================================================================
# Browser and logs
# ======================================================================

# Browser origins allowed to call auth and trade-api: the UI. Exact origins,
# comma-separated. With the frontend container the UI and the APIs share one
# origin, so this matters only for `npm start` and direct calls.
CORS_ALLOWED_ORIGINS=http://localhost:4200
# Behind a reverse proxy (the frontend container), which proxies auth may
# believe for the client's address: an Express trust-proxy value. Compose
# defaults it to uniquelocal (private networks); empty outside Docker.
TRUST_PROXY=
LOG_LEVEL=INFO

# Compose only: host ports the containers are published on.
API_PUBLISHED_PORT=8081
EXECUTOR_PUBLISHED_PORT=8082
AUTH_PUBLISHED_PORT=3000
