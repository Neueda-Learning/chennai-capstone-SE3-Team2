# Copy to .env and fill in. .env is gitignored and must never be committed.
#
#   cp .env.example .env
#   docker compose --profile platform up -d --build

# --- database -------------------------------------------------------
DB_NAME=trading
DB_USER=postgres
DB_PASSWORD=change-me-locally
DB_PUBLISHED_PORT=5432

# --- trade api ------------------------------------------------------
API_PUBLISHED_PORT=8080
LOG_LEVEL=INFO

# --- trade executor (sprint 7) --------------------------------------
EXECUTOR_PUBLISHED_PORT=8081

# A credential. Belongs here, in no properties file and no constant.
FAUXNANCE_API_KEY=replace-with-your-cohort-key

# Override only if the instructor moves the API.
FAUXNANCE_BASE_URL=https://y4t9nq2bqf.execute-api.eu-west-2.amazonaws.com/v1

# Seconds between market-data polls. 60 costs 1440 of the 2000 daily
# Fauxnance requests, leaving 560 for pricing orders. The floor is
# enforced in code and scales with the symbol count.
POLL_INTERVAL_SECONDS=60

# --- signing --------------------------------------------------------
# At least 32 bytes: HS256 needs 256 bits of key, and the service
# refuses to start with anything shorter rather than signing weakly.
# Generate one with:  openssl rand -base64 48
JWT_SECRET=replace-with-openssl-rand-base64-48-output-not-this

# --- auth service (sprint 8) ----------------------------------------
AUTH_PUBLISHED_PORT=3000

# Its own database. A separate service holding credentials should not
# also hold a connection to the trading data.
AUTH_DB_NAME=auth
AUTH_DB_USER=auth
AUTH_DB_PASSWORD=change-me-locally
AUTH_DB_PUBLISHED_PORT=5433

# Whoever signs the tokens. The Trade REST API verifies this value.
JWT_ISSUER=auth-service

# --- login throttle (sprint 9) --------------------------------------
# The hosted Redis behind the five-failure limit, shared by every auth
# instance. Required: compose refuses to start without it. The URL
# carries the password, which is why it belongs here and nowhere else.
# Unreachable at runtime, the throttle counts in memory, per instance,
# and warns until Redis answers again.
REDIS_URL=redis://default:<password>@<host>:<port>

# --- account activation (sprint 9) ----------------------------------
# Shared by auth and the Trade REST API: guards auth's internal
# token-minting route. At least 32 bytes. Generate with:
#   openssl rand -base64 48
ACTIVATION_INTERNAL_SECRET=replace-with-openssl-rand-base64-48-output-not-this

# The link in the activation email. Points at auth's /activate page.
ACTIVATION_LINK_BASE_URL=http://localhost:3000/activate

# Where a customer lands after registering from the link.
ACTIVATION_HOME_URL=http://localhost:4200/

# Outgoing mail. Gmail: an app password, not your account password
# (Google Account > Security > 2-Step Verification > App passwords).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=justtosuffer2@gmail.com
SMTP_PASSWORD=whyarewehere
ACTIVATION_MAIL_FROM=justtosuffer2@gmail.com
