# Copy to .env and fill in. .env is gitignored and must never be committed.
#
#   cp .env.example .env
#   docker compose --profile platform up -d --build

# --- database -------------------------------------------------------
DB_NAME=trading
DB_USER=postgres
DB_PASSWORD=change-me-locally
DB_PUBLISHED_PORT=5432

# --- trade api ------------------------------------------------------
API_PUBLISHED_PORT=8080
LOG_LEVEL=INFO

# --- trade executor (sprint 7) --------------------------------------
EXECUTOR_PUBLISHED_PORT=8081

# The Fauxnance key your cohort was issued. A CREDENTIAL: it belongs in
# .env, which is gitignored, and in no properties file, YAML file or
# Java constant. The executor refuses to start without it rather than
# accepting orders it cannot price.
FAUXNANCE_API_KEY=replace-with-your-cohort-key

# Override only if the instructor moves the API.
FAUXNANCE_BASE_URL=https://y4t9nq2bqf.execute-api.eu-west-2.amazonaws.com/v1

# How often the market-data poller fetches a batch of quotes.
#
# THE ARITHMETIC, because the quota is 2000 requests per key per day and
# the poller shares it with every fill the executor prices:
#
#     calls per cycle = ceil(symbols / 25)      the batch endpoint's cap
#     calls per day   = (86400 / interval) x calls per cycle
#
#   60s, <=25 symbols ->  1440/day, 560 left for fills.   Runs all day.
#   30s, <=25 symbols ->  2880/day.  The key is gone by mid-afternoon.
#   15s, <=25 symbols ->  5760/day.  Gone before lunch.
#
# 60 is also the floor, and it is enforced in code rather than
# documented and hoped for: a smaller value here is clamped up and the
# arithmetic is logged. Anything below 60 does not survive being left
# running overnight.
POLL_INTERVAL_SECONDS=60

# --- signing --------------------------------------------------------
# At least 32 bytes: HS256 needs 256 bits of key, and the service
# refuses to start with anything shorter rather than signing weakly.
# Generate one with:  openssl rand -base64 48
JWT_SECRET=replace-with-openssl-rand-base64-48-output-not-this
