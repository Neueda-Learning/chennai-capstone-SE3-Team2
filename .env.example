# ONE settings file for the whole platform. Copy it to .env and fill in the
# values marked REQUIRED. .env is gitignored: never commit it.
#
#   Linux / macOS:   cp .env.example .env
#   Windows:         copy .env.example .env
#
# Who reads it:
#   - docker compose, for every container  (docker compose --profile platform up -d --build)
#   - trade-api and the executor, when started from IntelliJ or mvn (not in a container)
#   - auth, when started with npm run start:dev                     (not in a container)
# In a container, compose sets the service addresses itself (postgres, kafka,
# auth), so the localhost values below only apply outside one.
#
# Format: KEY=value, one per line. Comments on their own lines only -- never
# after a value. No quotes. Avoid $ in values: use letters and digits, e.g.
#   openssl rand -hex 32
#
# Ports are fixed and need no setting: UI 4200, auth 3000, trade-api 8085,
# executor 8081, PostgreSQL 5432, Kafka 9092.


# ======================================================================
# PostgreSQL -- one instance on 5432, two databases inside: trading, auth
# ======================================================================

# Where the services find it. Outside a container: localhost.
DB_HOST=localhost
DB_PORT=5432

# The superuser: only builds the databases (compose's init, or
# data/db/local/setup.sql on Windows). No service ever connects as it.
POSTGRES_SUPERUSER=postgres
# REQUIRED by compose. On Windows: the password chosen when installing PostgreSQL.
POSTGRES_SUPERUSER_PASSWORD=change-me

# trade-api and the executor: read/write on trading. Not the superuser.
DB_NAME=trading
DB_USER=trading_app
# REQUIRED.
DB_PASSWORD=change-me

# The analytics extract: read-only on trading.
ANALYTICS_DB_USER=analytics_ro
# REQUIRED by compose.
ANALYTICS_DB_PASSWORD=change-me

# auth: its own database on the same instance, and only that one.
AUTH_DB_NAME=auth
AUTH_DB_USER=auth_app
# REQUIRED. auth builds its connection URL from these and DB_HOST/DB_PORT.
AUTH_DB_PASSWORD=change-me

# Compose only: the host port the Postgres container is published on.
DB_PUBLISHED_PORT=5432


# ======================================================================
# Kafka -- in a container. On Windows it is on the EC2 instance, reached
# through the SSH forward (ssh -L 9092:localhost:9092 ...).
# ======================================================================

# trade-api and the executor.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# auth. REQUIRED.
KAFKA_BROKERS=localhost:9092


# ======================================================================
# Tokens -- auth signs them, trade-api checks them, with the same secret
# ======================================================================

# REQUIRED. At least 32 bytes:  openssl rand -hex 32
JWT_SECRET=replace-with-openssl-rand-hex-32-output
JWT_ISSUER=auth-service


# ======================================================================
# Account activation -- the email with the one-time link
# ======================================================================

# REQUIRED. Shared by auth and trade-api; guards auth's internal route.
# At least 32 bytes:  openssl rand -hex 32
ACTIVATION_INTERNAL_SECRET=replace-with-openssl-rand-hex-32-output

# How trade-api reaches auth to mint a link.
AUTH_INTERNAL_URL=http://localhost:3000
# The link in the email: auth's /activate page.
ACTIVATION_LINK_BASE_URL=http://localhost:3000/activate
# Where the customer lands after choosing a password: the UI.
ACTIVATION_HOME_URL=http://localhost:4200/

# Outgoing mail. Gmail: an app password, not the account password
# (Google Account > Security > 2-Step Verification > App passwords).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# REQUIRED.
SMTP_USERNAME=your-team-address@gmail.com
# REQUIRED.
SMTP_PASSWORD=your-16-character-app-password
# REQUIRED. Usually the same as SMTP_USERNAME.
ACTIVATION_MAIL_FROM=your-team-address@gmail.com


# ======================================================================
# Login throttle -- five failed logins, then a minute's wait
# ======================================================================

# REQUIRED by compose. The hosted Redis every auth instance counts in.
# Outside compose it may be left out: the count is then kept in memory.
REDIS_URL=redis://default:password@host:port


# ======================================================================
# Prices -- the executor prices every order before it fills
# ======================================================================

# REQUIRED. Stocks and ETFs.
FAUXNANCE_API_KEY=replace-with-your-cohort-key
FAUXNANCE_BASE_URL=https://y4t9nq2bqf.execute-api.eu-west-2.amazonaws.com/v1
# Seconds between market-data polls. 60 costs 1440 of the 2000 daily
# Fauxnance requests. The floor is enforced in code.
POLL_INTERVAL_SECONDS=60

# Mutual funds, at the latest NAV. Optional: without a key, fund orders are
# rejected with no price and everything else still trades.
MF_NAV_API_KEY=
MF_NAV_BASE_URL=https://mf-fauxnance-api.onrender.com


# ======================================================================
# Timings -- optional; these are the defaults
# ======================================================================

# How long KYC waits before checking an application (shorten for a demo),
# how often it looks, and how many failed checks before a customer is set aside.
KYC_DELAY=30s
KYC_JOB_INTERVAL_MS=10000
KYC_MAX_ATTEMPTS=5
# How long the payment gateway takes to decide a deposit or withdrawal.
PAYMENT_DELAY=3s
# How often trade-api and auth publish what their outboxes hold.
OUTBOX_POLL_MS=2000


# ======================================================================
# Browser and logs
# ======================================================================

# Browser origins allowed to call auth and trade-api: the UI. Exact origins,
# comma-separated.
CORS_ALLOWED_ORIGINS=http://localhost:4200
LOG_LEVEL=INFO

# Compose only: host ports the containers are published on.
API_PUBLISHED_PORT=8085
EXECUTOR_PUBLISHED_PORT=8081
AUTH_PUBLISHED_PORT=3000
